{
  "presets": {
    "orangepi": {
      "renderingBackend": "gles2",
      "useDRM": true,
      "maxTextureDimension": 256,
      "maxPolygonsPerFrame": 40000,
      "clipDistance": 300.0,
      "entityRenderDistance": 300.0,
      "textureMemoryBytes": 33554432,
      "framebufferMemoryBytes": 10485760,
      "enableMipmaps": true,
      "enableCompressedTextures": false,
      "enableNPOT": true,
      "enableStencilBuffer": true,
      "enableAlphaToCoverage": true,
      "enableShaders": true,
      "antiAliasLevel": 4,
      "anisotropicFilterLevel": 4,
      "fog": true,
      "playerLight": true,
      "objectLights": true,
      "directionalLight": true,
      "fireEffects": true,
      "skyRendering": true,
      "skyTextures": "original",
      "skipSkyTextureUpload": false,
      "nameTagsEnabled": true,
      "skipManualZoneDraw": false,
      "skipVBOUpload": false,
      "skipEntityTextureUpload": false,
      "skipEntityBuild": false,
      "skipObjectBuild": false,
      "skipConstrainedTextureUpload": false,
      "enableTextureAtlas": true,
      "enableItemIcons": true,
      "entityPrepMaxPvsDepth": 3,
      "terrainPrepMaxPvsDepth": 5,
      "objectPrepMaxPvsDepth": 3,
      "deferredAssetLoading": "automatic",
      "backgroundThreadCount": 1
    }
  }
}
