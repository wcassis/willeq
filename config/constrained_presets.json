{
  "presets": {
    "orangepi": {
      "renderingBackend": "gles2",
      "useDRM": true,
      "maxTextureDimension": 512,
      "maxPolygonsPerFrame": 80000,
      "clipDistance": 300.0,
      "entityRenderDistance": 300.0,
      "textureMemoryBytes": 67108864,
      "framebufferMemoryBytes": 10485760,
      "enableMipmaps": true,
      "enableCompressedTextures": false,
      "enableNPOT": true,
      "enableStencilBuffer": true,
      "enableAlphaToCoverage": true,
      "enableShaders": true,
      "antiAliasLevel": 4,
      "anisotropicFilterLevel": 4,
      "fog": true,
      "playerLight": true,
      "objectLights": true,
      "directionalLight": true,
      "fireEffects": true,
      "skyRendering": true,
      "nameTagsEnabled": true,
      "skipManualZoneDraw": true,
      "skipVBOUpload": true,
      "skipEntityTextureUpload": true,
      "skipEntityBuild": true,
      "skipConstrainedTextureUpload": true,
      "skipSkyTextureUpload": true,
      "enableTextureAtlas": false
    }
  }
}
