    "landingPopulation": {
        "rule": "B1123 (#443): every landing (impact + spellComplete) peaks at half the platform pool (constrained_presets.json spellParticlePool), so two overlapping landings, or 253's field beside one, fit; the rates below give each landing's schedule and SpellEffectsConfig::applyPool scales them to the peak. An exception is a landing the oracle fills with FEWER sprites: its peak is min(peakLive, half the pool).",
        "exceptions": {
            "41": {
                "peakLive": 2492,
                "why": "B1123 sweep (review/B1123/pool_fit.tsv): 2492 live reaches the oracle's 4.154 landing coverage at the shipped sizes"
            },
            "54": {
                "peakLive": 3517,
                "why": "B1123 completion lane-5 calibration (review/B1123/leg2/cal/m_k1): 3517 live reads 2.459 against the oracle's 2.461 landing coverage"
            },
            "656": {
                "peakLive": 3517,
                "why": "spells.eff record 23, one population with 54 (B1122's per-record rule); reads 2.13 of the oracle's 2.49 at it (review/B1123/leg2/cal/m_k1)"
            },
            "458": {
                "peakLive": 373,
                "why": "the oracle draws FEWER, LARGER sprites: at the style size it read 125 % of the oracle's 1.242 landing coverage with ROI p90 0.079 (band 0.086-0.116); lane-5 calibration (review/B1123/leg2/cal/m_k2) puts x1.3 sprites at ROI 0.104 and 0.6 of B1123's 622 at 0.71 of the coverage"
            }
        }
    },
    "sourceRecords": {
        "rule": "B1131 (#451): the Source (cast) stage per spells.eff record (spells_us.txt field 123), measured on the official client by the B1130 survey (review/B1130/anchor_table.tsv + record_table.tsv, fixed camera, caster heights above the feet). anchor: hands = the two hand bones, feet-ring = a ring at the feet rising lo->hi, orbit = an orbit of radius halfWidth over lo..hi (spiral: rising lo->hi), body = a cloud over lo..hi x +-halfWidth, head = a disc at the head bone (discLo..discHi, discShare of the sprites) with a column falling to lo. onset = seconds after BeginCast; holdOther / holdSelf = seconds the Source keeps emitting past OP_Action when the target is another entity / the caster (holdOther absent = self-only spell). Sprite sizes, lifetimes and art stay the castGlow/castSpray style's (sizes-first, !280); a spellOverrides castGlow/castSpray that sets spawnShape keeps its own geometry and rate. Rows: review/B1131/scripts/gen_source_records.py.",
        "scale": {"casterHeight": 6.5, "anchorAboveFeet": 3.6, "orbitAngularVelocity": 3.0, "why": "B1120 scale (H 6.5 world units, entity anchor 3.6 above the feet); orbit 3.0 rad/s = B1122's record-23 orbit (54/656 castGlow override)"},
        "population": {"record": 0, "spawnRate": 80, "why": "a record's spawnRate = 80/s x its oracle Source coverage / record 0's (0.170): record 0 (93/38) keeps B1122/B1123's calibrated castGlow rate, every other record scales by its measured coverage on the same instrument; SpellEffectsConfig::applyPool then fits each landing beside its own held Source"},
        "default": {"anchor": "body", "onset": 0.41, "holdOther": 4.0, "holdSelf": 0.33},
        "defaultWhy": "a record the survey did not reach, and a spell with no record: the style's own body cloud (B1122), the median onset of the 40 measured records and the median holdOther of the 28 other-target holds",
        "overrideRecords": {"38": 0, "93": 0, "41": 20, "54": 23, "656": 23, "253": 35, "458": 33},
        "overrideRecordsWhy": "spells_us.txt field 123 of every spell with a spellOverrides or landingPopulation row (the pool rule needs the Source hold of its record)",
