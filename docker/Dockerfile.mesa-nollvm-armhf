# B932: build environment for an LLVM-less Mesa for the Orange Pi (armhf,
# Ubuntu Noble ABI). Used by scripts/pi/build_mesa_nollvm.sh -- read that
# script's header for the option set and why each option is there.
#
# The source is Ubuntu's OWN source package for the exact version the Pi runs
# (apt-get source mesa=$MESA_DEBVER from noble-updates), so the A/B isolates
# the build options: same upstream tarball, same Ubuntu patches, same
# toolchain family. Only the meson options differ from Ubuntu's build.
#
# B935: this is also the SHIPPED prefix's build image (Will 2026-09-30, "ship
# the prefix"), and its patchelf writes ci-arm/<sha>/bin/willeq-nollvm. The
# tarball it produces is pinned (scripts/pi/mesa_nollvm.sha256); a change here
# that moves the bytes needs build_mesa_nollvm.sh --write-pin in the same commit.
#
# Cross build: amd64 build tools + armhf -dev packages via multiarch
# (archive.ubuntu.com serves amd64, ports.ubuntu.com serves armhf).

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ARG MESA_DEBVER=25.2.8-0ubuntu0.24.04.1

# amd64 from the archive, armhf from ports; deb-src for the mesa source package.
RUN rm -f /etc/apt/sources.list.d/ubuntu.sources && \
    printf '%s\n' \
      'Types: deb deb-src' \
      'URIs: http://archive.ubuntu.com/ubuntu/' \
      'Suites: noble noble-updates noble-security' \
      'Components: main universe' \
      'Architectures: amd64' \
      'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
      '' \
      'Types: deb' \
      'URIs: http://ports.ubuntu.com/ubuntu-ports/' \
      'Suites: noble noble-updates noble-security' \
      'Components: main universe' \
      'Architectures: armhf' \
      'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/ubuntu.sources && \
    dpkg --add-architecture armhf && \
    apt-get update && apt-get install -y --no-install-recommends \
      build-essential gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf \
      dpkg-dev pkg-config bison flex python3 python3-pip python3-venv \
      python3-mako python3-yaml python3-packaging python3-ply \
      ninja-build ca-certificates patchelf file xz-utils \
      libdrm-dev:armhf libexpat1-dev:armhf zlib1g-dev:armhf libzstd-dev:armhf \
    && rm -rf /var/lib/apt/lists/*

# Mesa 25.2 needs a newer meson than Noble's 1.3.2; pin it so the build is
# repeatable.
RUN python3 -m venv --system-site-packages /opt/meson && /opt/meson/bin/pip install --no-cache-dir meson==1.7.2
ENV PATH=/opt/meson/bin:$PATH

# The exact source the Pi's packages were built from. noble-updates has
# already moved on (0ubuntu0.24.04.2 on 2026-09-30), so fetch the Pi's
# version from the Launchpad librarian and check the .dsc's SHA256 sums.
WORKDIR /src
ARG MESA_DSC_SHA256_ORIG=097842f3e49d996868b38688db87b006f7d4541e93ce86d2f341d8b3e7be7c93
ARG MESA_DSC_SHA256_DEB=88c1164513cdcf69b1df7f0805e7b515ae44cdc530c57ce2754a92fd97ce80b2
RUN apt-get update && apt-get install -y --no-install-recommends curl libglvnd-core-dev:armhf && \
    rm -rf /var/lib/apt/lists/* && \
    base="https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/mesa/${MESA_DEBVER}" && \
    curl -fsSL -o mesa_25.2.8.orig.tar.xz "$base/mesa_25.2.8.orig.tar.xz" && \
    curl -fsSL -o "mesa_${MESA_DEBVER}.debian.tar.xz" "$base/mesa_${MESA_DEBVER}.debian.tar.xz" && \
    curl -fsSL -o "mesa_${MESA_DEBVER}.dsc" "$base/mesa_${MESA_DEBVER}.dsc" && \
    echo "${MESA_DSC_SHA256_ORIG}  mesa_25.2.8.orig.tar.xz" | sha256sum -c && \
    echo "${MESA_DSC_SHA256_DEB}  mesa_${MESA_DEBVER}.debian.tar.xz" | sha256sum -c && \
    dpkg-source --no-check -x "mesa_${MESA_DEBVER}.dsc" /src/mesa && \
    grep -q "^mesa (${MESA_DEBVER})" /src/mesa/debian/changelog

COPY scripts/pi/mesa_nollvm_cross.ini /opt/mesa_nollvm_cross.ini
