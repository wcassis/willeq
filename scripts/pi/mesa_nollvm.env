# B935 (#253): the ONE place that names the shipped LLVM-less Mesa prefix.
# Sourced by scripts/pi/build_mesa_nollvm.sh, publish_arm_build.sh,
# deploy_mesa_prefix.sh and scripts/pi_rendered_zone_sweep.sh.
#
# MESA_NOLLVM_PI_PREFIX is where the prefix LIVES on the Pi, and it is baked
# into the build: libgbm dlopens <prefix>/lib/gbm/dri_gbm.so and libgallium
# reads <prefix>/share/drirc.d by absolute paths compiled in from meson's
# --prefix, so the prefix is not relocatable. Changing it (or the version)
# changes the tarball's bytes, so scripts/pi/mesa_nollvm.sha256 must be
# re-pinned in the same commit (build_mesa_nollvm.sh --write-pin).
: "${MESA_NOLLVM_VERSION:=25.2.8}"
: "${MESA_NOLLVM_PI_PREFIX:=/home/user/mesa-nollvm-${MESA_NOLLVM_VERSION}}"
: "${MESA_NOLLVM_STORE_ROOT:=/mnt/projects/fable/ci-arm/mesa}"
MESA_NOLLVM_STORE="${MESA_NOLLVM_STORE_ROOT}/${MESA_NOLLVM_VERSION}"
MESA_NOLLVM_TARBALL="mesa-nollvm-${MESA_NOLLVM_VERSION}-armhf.tar.zst"
MESA_NOLLVM_PIN_FILE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/mesa_nollvm.sha256"
# The pinned SHA256 of the tarball (first field of the pin file's line).
mesa_nollvm_pin() {
    [ -f "$MESA_NOLLVM_PIN_FILE" ] || return 0
    awk -v t="$MESA_NOLLVM_TARBALL" '$2 == t {print $1; exit}' "$MESA_NOLLVM_PIN_FILE"
}
